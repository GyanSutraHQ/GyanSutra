# ──────────────────────────────────────────────────────────────
# Gyan Sutra Backend - Environment Variables
# Copy this to .env and fill in your real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# ── Firebase Admin SDK ───────────────────────────────────────
# Path to your Firebase service account JSON file (local dev only).
# On Render, paste the entire JSON content into FIREBASE_SERVICE_ACCOUNT_JSON instead.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json

# Alternatively (preferred for Render deployment):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Your Firebase project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── AI Providers ─────────────────────────────────────────────
# Primary Google Gemini provider.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional OpenRouter fallback provider. Change RAG_PROVIDER_ORDER to prioritize it.
OPENROUTER_API_KEY=

# Optional Groq fallback, used when the primary provider is unavailable.
GROQ_API_KEY=your_groq_api_key_here

# Optional comma-separated model chains. Stable, economical defaults are shown.
GEMINI_GENERATION_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
OPENROUTER_MODELS=
GROQ_MODELS=openai/gpt-oss-20b

# Provider priority and bounded generation. Sarathi tries independent providers
# first, then a backup model when a short-lived provider error occurs.
RAG_PROVIDER_ORDER=gemini,groq,openrouter
RAG_MAX_MODEL_ATTEMPTS=3
RAG_MODEL_TIMEOUT_MS=10000
RAG_GENERATION_DEADLINE_MS=24000
RAG_MAX_CONCURRENT_GENERATIONS=2
RAG_MODEL_QUEUE_TIMEOUT_MS=5000
RAG_MAX_OUTPUT_TOKENS=1200

# Source-grounded synthesis is simple enough for minimal reasoning, which keeps
# Gemini 3 latency and hidden reasoning-token use under control.
GEMINI_REASONING_EFFORT=minimal

# ── RAG Configuration ────────────────────────────────────────
# Sarathi answers greetings, identity questions, and clearly non-scripture
# utility requests locally before retrieval, so they do not use model credits.
# The built-in guardrail intentionally uses narrow, high-confidence patterns.
# Minimum cosine similarity for marking a verse as a direct citation.
# Range: 0.0 to 1.0.
RAG_SIMILARITY_THRESHOLD=0.55

# Number of verses to retrieve per query before threshold filtering
RAG_TOP_K=12

# Maximum evidence passages and prompt size sent to the model.
RAG_TOP_CONTEXT=4
RAG_MAX_CONTEXT_CHARS=7000
RAG_MAX_COMMENTARIES=2
RAG_MAX_COMMENTARY_CHARS=650
RAG_RETRIEVAL_TIMEOUT_MS=8000

# Safe exact caches. Increment RAG_CORPUS_VERSION after re-ingesting embeddings
# or materially changing scripture data so old entries are not reused.
RAG_CACHE_ENABLED=true
RAG_CACHE_MAX_ENTRIES=250
RAG_RESPONSE_CACHE_TTL_SECONDS=21600
RAG_RETRIEVAL_CACHE_TTL_SECONDS=3600
RAG_CORPUS_VERSION=gita-ramayana-v1

# Local embedding runtime. Prefixes remain empty for GTE. If the complete corpus
# is migrated to multilingual E5, set query/passage prefixes and re-ingest every
# vector before serving traffic.
EMBEDDING_MODEL_ID=Xenova/gte-small
EMBEDDING_DIMENSIONS=384
EMBEDDING_QUERY_PREFIX=
EMBEDDING_PASSAGE_PREFIX=
EMBEDDING_CACHE_MAX_ENTRIES=500
EMBEDDING_CACHE_TTL_SECONDS=86400
EMBEDDING_PREWARM=true

# ── Server ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
# Example: https://gyansutra.pages.dev,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ── Rate Limiting ────────────────────────────────────────────
# Max requests per 15 minutes per IP on /ask endpoint
ASK_RATE_LIMIT_MAX=20

# Number of trusted reverse proxies between the client and Express.
# Use 1 on Render. Keep unset for direct local development.
TRUST_PROXY_HOPS=
# Optional free, self-hosted expressive narration (see narration/README.md).
# NARRATION_SERVICE_URL=http://127.0.0.1:8001
# NARRATION_SERVICE_TOKEN=
