# EditorConfig helps keep formatting consistent across editors and operating systems.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{java,xml,gradle,properties}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2
