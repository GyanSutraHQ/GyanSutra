/search
  X-Robots-Tag: noindex, follow
  Cache-Control: no-cache

# The production site is served only from https://gyansutraapp.com. These
# alternate Cloudflare hostnames are retained for delivery, but must never
# compete with the canonical site in search results.
https://www.gyansutraapp.com/*
  X-Robots-Tag: noindex, follow

https://gyansutraapp.pages.dev/*
  X-Robots-Tag: noindex, follow

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate

/version.json
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: no-cache

/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/gita
  Cache-Control: no-cache

/bhagavad-gita
  Cache-Control: no-cache

/ramayana
  Cache-Control: no-cache

/valmiki-ramayana
  Cache-Control: no-cache

/vishnu-purana
  Cache-Control: no-cache

/vishnu-purana/*
  Cache-Control: no-cache

/ask
  Cache-Control: no-cache

/faq
  Cache-Control: no-cache

/topics/*
  Cache-Control: no-cache

/chapters/*
  Cache-Control: no-cache

/verses/*
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
